{
  "appId": "com.prepcart.app",
  "appName": "Prepcart",
  "webDir": "dist",
  "ios": {
    "contentInset": "automatic"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com",
        "apple.com",
        "facebook.com"
      ]
    }
  }
}
