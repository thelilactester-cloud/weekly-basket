{
  "name": "prepcart",
  "version": "3.0.0",
  "private": true,
  "description": "Prepcart: weekly family meal prep and shopping lists for your supermarket and diets.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.mjs",
    "cap:add:ios": "npm run build && cap add ios",
    "cap:add:android": "npm run build && cap add android",
    "cap:sync": "npm run build && cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "icons": "capacitor-assets generate --iconBackgroundColor '#1f9d55' --splashBackgroundColor '#f6f4ef'",
    "android:apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "vendor": "node scripts/vendor.mjs",
    "cap:configure": "node scripts/configure-native.mjs"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.28.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor-firebase/authentication": "^8.5.0",
    "@revenuecat/purchases-capacitor": "^13.0.0",
    "firebase": "^12.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
