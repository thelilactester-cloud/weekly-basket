rules_version = '2';
// Who can read and write what in the database. Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function activeAffiliate(code) {
      return code is string && exists(/databases/$(database)/documents/affiliates/$(code))
        && get(/databases/$(database)/documents/affiliates/$(code)).data.active == true;
    }
    function validReferral(r) { return r == null || (r is map && activeAffiliate(r.code)); }

    // One document per account: email, name, consent, affiliate code. Nothing about diets or health.
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'createdAt', 'consent', 'referral'])
        && validReferral(request.resource.data.get('referral', null));
      // The affiliate code can be added once and never changed (so commissions can't be redirected).
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referral', 'name'])
        && (resource.data.get('referral', null) == null || request.resource.data.get('referral', null) == resource.data.get('referral', null))
        && validReferral(request.resource.data.get('referral', null));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Public part of an affiliate (name, active, Apple offer code). Anyone can look up one code; only admins can list or change.
    match /affiliates/{code} {
      allow get: if true;
      allow list, write: if isAdmin();
    }
    // Private part (payout email, notes).
    match /affiliatePrivate/{code} {
      allow read, write: if isAdmin();
    }
    // Written only by the revenuecatWebhook function. Admins can mark them paid.
    match /commissions/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid', 'paidAt']);
      allow create, delete: if false;
    }
    // Household sharing. The plan and the people are encrypted on the phones (js/household.js): the server only
    // sees ciphertext and which accounts belong to the household. Joining goes through the joinHousehold function.
    function household(hid) { return get(/databases/$(database)/documents/households/$(hid)).data; }
    function inHousehold(hid) { return signedIn() && request.auth.uid in household(hid).members; }
    match /households/{hid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.keys().hasOnly(['owner', 'members', 'iv', 'ct', 'updatedBy', 'createdAt']);
      // Members change the encrypted plan; the owner can also remove members (never add: that's joinHousehold).
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['iv', 'ct', 'updatedBy', 'members'])
        && (request.resource.data.members == resource.data.members
          || (request.auth.uid == resource.data.owner && resource.data.members.hasAll(request.resource.data.members)
              && request.resource.data.members.hasAny([resource.data.owner])));
      allow delete: if signedIn() && request.auth.uid == resource.data.owner;
      match /people/{pid} {
        allow read, delete: if inHousehold(hid);
        allow create, update: if inHousehold(hid) && request.resource.data.keys().hasOnly(['iv', 'ct', 'updatedBy']);
      }
      match /invites/{token} {
        allow create: if inHousehold(hid) && request.resource.data.keys().hasOnly(['createdBy', 'expiresAt'])
          && request.resource.data.createdBy == request.auth.uid;
        allow delete: if inHousehold(hid);
        allow read, update: if false; // checked by joinHousehold only
      }
    }

    // Admin accounts: added by hand in the Firebase console (see LAUNCH.md).
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
